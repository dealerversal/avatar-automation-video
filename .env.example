# Server Port
PORT=5001

# MongoDB Connection URL
MONGODB_URI=mongodb://username:password@host:27017/dv-content-genrator?authSource=admin

# Browser Automation Configurations
HEADLESS=true
BROWSER_TIMEOUT_MS=240000
SLOW_MO_MS=50
PROFILE_DIR=./browser-profile

# Cloudflare R2 Storage Credentials
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=dealer-versal
R2_PUBLIC_DOMAIN=https://your-r2-public-domain.r2.dev
