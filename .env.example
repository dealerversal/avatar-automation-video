# Server Port & PM2 Process Name
PORT=5001
PM2_APP_NAME=gen.socialversal.online

# MongoDB Connection URL & Database Name
MONGODB_URI=mongodb://username:password@host:27017/avatar-automation-video-dev?authSource=admin
MONGODB_NAME=avatar-automation-video-dev

# Browser Automation Configurations
HEADLESS=true
BROWSER_TIMEOUT_MS=240000
SLOW_MO_MS=50
PROFILE_DIR=./browser-profile

# Cloudflare R2 Storage Credentials
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=dealer-versal
R2_PUBLIC_DOMAIN=https://your-r2-public-domain.r2.dev
